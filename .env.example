# ==============================================================================
# BookLeaf Portal - Master Environment Configuration (.env.example)
# Copy to .env or appropriate app-level .env files before running.
# ==============================================================================

# Node Environment ('development', 'production', 'test')
NODE_ENV=development

# Database Connection (PostgreSQL)
# Note: In local development, port 5433 or 5432 may be configured.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bookleaf?schema=public"

# Backend API Configuration
PORT=3001
API_PREFIX=/api/v1
CORS_ORIGIN="http://localhost:3000"

# JWT Authentication
JWT_SECRET="bookleaf-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="bookleaf-secure-cookie-secret-key-32-chars"

# AI Provider Configuration
# AI_PROVIDER: 'anthropic' (default) or 'openai'
AI_PROVIDER=anthropic
# AI_MODEL: e.g. claude-3-5-haiku-latest, claude-haiku-5-5, or gpt-4o-mini
AI_MODEL=claude-3-5-haiku-20241022

# LLM API Keys (Server-side ONLY - never expose to frontend)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# SLA Configuration (in hours)
SLA_HOURS_CRITICAL=4
SLA_HOURS_HIGH=24
SLA_HOURS_MEDIUM=72
SLA_HOURS_LOW=168

# Frontend Web Configuration (apps/web)
NEXT_PUBLIC_APP_NAME="BookLeaf Author Portal"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
API_INTERNAL_URL="http://localhost:3001"
